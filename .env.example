# Copy this file to .env for local settings (optional).
# On Vercel, add these under Project → Settings → Environment Variables.

# Password for /admin. Required online. Locally the default is: karrada-admin
ADMIN_PASSWORD=

# Database. On Vercel: Storage → Create → Neon (Postgres). This fills DATABASE_URL for you.
# Leave empty locally: data is saved in the .data folder.
DATABASE_URL=

# Photo uploads. On Vercel: Storage → Create → Blob. This fills BLOB_READ_WRITE_TOKEN for you.
BLOB_READ_WRITE_TOKEN=
